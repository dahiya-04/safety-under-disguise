# Copy this file to .env and fill in your own keys. Never commit .env.
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)

# Hugging Face token for the target models (and the HF judge endpoint).
# Fine-grained token with the "Make calls to Inference Providers" permission:
# https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Goedel Machines API key for the primary judge endpoint (DeepSeek-V4.1-Flash).
# Optional: without it, set the judge in configs/encoding_attacks.yaml to use only the HF endpoint.
GOEDEL_API_KEY=your_goedel_key_here
