# Secrets — never commit
.env
.env.*
!.env.example

# Python / tooling
.venv/
__pycache__/
*.pyc
.pytest_cache/
.vscode/
.idea/

# Data: rebuilt by scripts/download_datasets.py and scripts/translate_prompts.py
data/raw/
data/cache/
data/processed/*
!data/processed/sample_metadata.json

# Results: raw model responses can contain harmful content — keep local.
# Only the aggregate outputs of the main run are published.
results/*
!results/encoding/
results/encoding/*
!results/encoding/20261114-130959_full_v1/
results/encoding/20261114-130959_full_v1/results.csv
results/judge_validation/
results/judge_comparison/

# Experiment 3: prompts/translations and raw responses stay local
experiment_3/data/
experiment_3/results/**/results.csv

# Local tool settings and pilot runs stay local
.claude/settings.local.json
experiment_3/results/*_pilot*/

# Experiment 3.1: judge cache and per-response files stay local
experiment_3_1/data/
experiment_3_1/results/judge_check.csv
experiment_3_1/results/disagreements_*.csv
